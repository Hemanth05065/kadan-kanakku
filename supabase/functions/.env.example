# Server-side AI settings for the edge functions. Every model here is open-weight.
# Local:  cp supabase/functions/.env.example supabase/functions/.env  (then `supabase functions serve`)
# Cloud:  supabase secrets set --env-file supabase/functions/.env

# ── Option A: self-hosted (ai-server/docker-compose.yml) ─────────────────────
# From `supabase start`, the functions run in Docker: reach your host via host.docker.internal.
# From hosted Supabase, expose the AI server with a tunnel (cloudflared / ngrok) or a VPS URL.
STT_BASE_URL=http://host.docker.internal:8000/v1
STT_MODEL=Systran/faster-whisper-large-v3
STT_API_KEY=

LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=

# Optional server voice (docker compose --profile tts up -d)
TTS_BASE_URL=
TTS_MODEL=ai4bharat/indic-parler-tts

# ── Option B: hosted open weights on Groq (fastest to set up) ────────────────
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3
# STT_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...
