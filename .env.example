# Copy to .env.local and fill in. Leave both empty to run in local demo mode
# (data stays on the device, browser speech recognition + on-device parser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side secrets are NOT set here. Set them on Supabase:
#   supabase secrets set SARVAM_API_KEY=... ANTHROPIC_API_KEY=...
# See README.md.
